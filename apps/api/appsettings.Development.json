{
  // A3 join email verification — TEST BYPASS. Entering this value as the
  // verification code on /join skips the emailed one-time code (most dev/demo
  // player emails are fake). Development config ONLY: appsettings.json and the
  // production environment must never set it — an unset/empty value disables
  // the bypass, so production stays email-verified by default.
  "JoinVerification": {
    "TestBypassCode": "999999"
  },
  // Request-pipeline and SQL logging are at Warning: at Information every 2 ms
  // status poll printed ~12 lines and buried the app's own logs. To trace a
  // request or see the SQL EF sends, set "Microsoft.AspNetCore" and/or
  // "Microsoft.EntityFrameworkCore.Database.Command" back to "Information".
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "GolfFundraiserPro": "Debug"
    }
  }
}
