{
  "expo": {
    "name": "GFP Scorer",
    "slug": "gfp-scorer",
    "version": "1.0.0",
    "scheme": "gfp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-sqlite",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.pro.golffundraiser.scorer",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "extraProguardRules": "# Stripe push provisioning is compileOnly (we don't issue cards) — see plugins/withAndroidBuildFixes.js\n-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ],
      "./plugins/withAndroidBuildFixes"
    ],
    "ios": {
      "bundleIdentifier": "pro.golffundraiser.scorer",
      "supportsTablet": true
    },
    "android": {
      "package": "pro.golffundraiser.scorer",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#31572c"
      }
    },
    "extra": {
      "eas": {
        "projectId": "cdbd213f-592f-42b7-a8f7-2723da7dda17"
      }
    },
    "owner": "adamnix",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdbd213f-592f-42b7-a8f7-2723da7dda17"
    }
  }
}
