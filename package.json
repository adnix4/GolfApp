    "check-updates": "node scripts/check-updates.js",
    "audit:prod": "node scripts/audit-prod.js",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.9",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.7"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.7",
    "react-native": "0.86.3",
    "react-native-screens": "4.26.2",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
