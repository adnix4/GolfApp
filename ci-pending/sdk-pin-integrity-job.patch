diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2d604c3..f59b0f6 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -149,6 +149,35 @@ jobs:
         if: always()
         run: npm audit || true
 
+  # ── SDK PIN INTEGRITY ─────────────────────────────────────────────────────
+  # Fails when a manifest pin or an installed version has drifted away from the
+  # version Expo SDK 57 actually targets, or away from the Node/React version
+  # this repo runs. Targets are fetched live from api.expo.dev, so this needs no
+  # hand-maintained table and cannot go stale.
+  #
+  # This exists because the weekly dependency routine twice bumped an
+  # SDK-managed package to npm's `latest` (react-native 0.87 in PR #40, react
+  # 19.3.0 in PR #64). Both passed lint, type-check and tests — no peer range in
+  # the tree is tight enough to catch it — so only an explicit check does.
+  #
+  # Degrades to a pass with a warning if api.expo.dev is unreachable, so a
+  # network blip never fails the build.
+  dependency-pins:
+    name: SDK Pin Integrity
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Assert SDK-managed and runtime-tracked pins
+        run: npm run check-updates -- --assert-pins
+
   # ── REQUIRED STATUS CHECK GATE ──────────────────────────────────────────
   # This job runs only after both above jobs succeed.
   # GitHub branch protection can require THIS single job instead of
@@ -156,7 +185,7 @@ jobs:
   all-checks-passed:
     name: All CI Checks Passed
     runs-on: ubuntu-latest
-    needs: [typescript-checks, dotnet-build, dependency-audit]
+    needs: [typescript-checks, dotnet-build, dependency-audit, dependency-pins]
     if: always()
 
     steps:
@@ -164,6 +193,10 @@ jobs:
         # If any upstream job failed or was cancelled, fail this job too.
         # This provides a single required status check for branch protection.
         run: |
+          if [[ "${{ needs.dependency-pins.result }}" != "success" ]]; then
+            echo "SDK pin integrity check failed"
+            exit 1
+          fi
           if [[ "${{ needs.typescript-checks.result }}" != "success" ]]; then
             echo "TypeScript checks failed"
             exit 1
