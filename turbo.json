{
  "$schema": "https://turbo.build/schema.json",
  // Stop turbo writing a root AGENTS.md when it detects an AI agent. Agent
  // guidance lives in CLAUDE.md, which points at the bundled turbo docs.
  "agentGuidance": false,
  // The root eslint config lives outside every workspace, so without this a
  // rule change alone would not invalidate any workspace's cached lint result.
  "globalDependencies": ["eslint.config.mjs"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!**/.next/cache/**",
        "dist/**",
        ".expo/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
